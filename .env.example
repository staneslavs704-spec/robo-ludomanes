# ОБЯЗАТЕЛЬНО заполнить перед запуском
BOT_TOKEN=ВСТАВЬ_ТОКЕН_БОТА
ADMIN_ID=123456789
WEBAPP_URL=https://example.com

# Локально в Termux используется SQLite.
DATABASE_URL=sqlite+aiosqlite:///./database.db
# Для VPS в docker-compose DATABASE_URL переопределяется на PostgreSQL.

# Настройки игровых правил
STARS_PER_SPIN=50
# Включать только после проверки законодательства и правил розыгрышей.
PAID_WHEEL_ENABLED=false
QUEST_SPIN_COST=100
REFERRALS_PER_FREE_SPIN=3
POINTS_PER_REFERRAL=10
POINTS_FOR_CHANNEL=50

# Необязательно. Например: @my_channel
# Бот должен быть администратором канала для надёжной проверки подписки.
REQUIRED_CHANNEL=
CHANNEL_URL=

# initData Telegram должен быть не старше 24 часов
INIT_DATA_MAX_AGE_SECONDS=86400
LOG_LEVEL=INFO

# Требуется только для VPS / Docker Compose. Заменить на случайный длинный пароль.
POSTGRES_PASSWORD=
